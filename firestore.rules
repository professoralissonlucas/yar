rules_version = '2';

// Regras do Firestore do Yar! (modo online).
//
// Formato da sala: ver src/online/roomState.js e a seção "Multijogador online"
// do CLAUDE.md. Não há Cloud Functions: o jogo roda no cliente, e estas regras
// garantem QUEM pode mudar O QUÊ e que os dados gravados fazem sentido — para
// ninguém trapacear editando o banco pelo console do navegador.
//
// Limite assumido: as cartas são sorteadas no navegador de quem está na vez.
// As regras conferem a forma e a progressão de cada jogada (cartas trancadas
// não mudam, o baralho encolhe certo, uma categoria vazia por marcação, pontos
// dentro da faixa da categoria), mas não provam que o embaralhamento foi
// honesto nem que os pontos são exatamente os da mão.
//
// LIMITE DO FIRESTORE: no máximo 1000 expressões avaliadas por gravação (acima
// disso a gravação é recusada com permission-denied). Por isso:
//   - a sala antes/depois e os campos alterados são lidos UMA vez e passados
//     como parâmetro (s = antes, n = depois, ch = campos alterados);
//   - cada gravação é despachada cedo para UMA ação (pelo `rev` e pelo status
//     da sala; dentro da partida, pelo `drawsUsed`), em vez de testar todas;
//   - "o resto não mudou" é conferido com diff() em vez de campo a campo.
// Os testes no emulador (npm run test:rules) incluem uma folga: todas as
// jogadas legítimas precisam passar mesmo com expressões extras somadas.
//
// Espelho em JavaScript destas regras de jogada (usado só nos testes):
// tests/online/rulesMirror.js — mantenha os dois iguais.

service cloud.firestore {
  match /databases/{database}/documents {

    // Qualquer outra coleção fica fechada: sem uma regra "allow", tudo é negado.

    match /rooms/{code} {

      // ================================================== tabelas do jogo

      // Modos (espelho de src/core/modes.js): tiradas por turno e categorias, na ordem.
      function modes() {
        return {
          'basic': { 'draws': 3, 'cats': ['ones', 'twos', 'threes', 'fours', 'fives', 'sixes'] },
          'odd': { 'draws': 3, 'cats': ['ones', 'threes', 'fives', 'pair', 'three_kind', 'chance'] },
          'even': { 'draws': 3, 'cats': ['twos', 'fours', 'sixes', 'pair', 'three_kind', 'chance'] },
          'pairs': { 'draws': 3, 'cats': ['ones', 'twos', 'threes', 'fours', 'fives', 'sixes', 'two_pair', 'full_house'] },
          'low': { 'draws': 3, 'cats': ['ones', 'twos', 'threes', 'pair', 'two_pair', 'chance'] },
          'sequence': { 'draws': 4, 'cats': ['ones', 'twos', 'threes', 'fours', 'fives', 'sixes', 'small_straight', 'large_straight'] },
          'no_numbers': { 'draws': 4, 'cats': ['pair', 'three_kind', 'four_kind', 'two_pair', 'full_house', 'yar',
            'small_straight', 'large_straight', 'chance'] },
          'full': { 'draws': 4, 'cats': ['ones', 'twos', 'threes', 'fours', 'fives', 'sixes', 'pair', 'three_kind',
            'four_kind', 'two_pair', 'full_house', 'yar', 'small_straight', 'large_straight', 'chance'] }
        };
      }

      // Pontuação mínima e máxima de cada categoria (espelho de src/core/scoring.js).
      function catRange() {
        return {
          'ones': [0, 5], 'twos': [0, 10], 'threes': [0, 15], 'fours': [0, 20], 'fives': [0, 25],
          'sixes': [0, 30], 'pair': [0, 12], 'three_kind': [0, 18], 'four_kind': [0, 24],
          'two_pair': [0, 15], 'full_house': [0, 25], 'yar': [0, 50], 'small_straight': [0, 30],
          'large_straight': [0, 40], 'chance': [5, 30]
        };
      }

      // Campos permitidos (nada de campo extra: keys().hasOnly limita o tamanho do documento).
      function roomKeys() {
        return ['hostUid', 'guestUid', 'players', 'mode', 'timerEnabled', 'status', 'createdAt', 'updatedAt',
          'expireAt', 'rev', 'match', 'game', 'presence', 'rematch', 'forfeitUid'];
      }

      function gameKeys() {
        return ['modeId', 'maxDraws', 'categories', 'deckCopiesPerValue', 'players', 'currentPlayerIndex',
          'round', 'turn', 'scores', 'status', 'lastScored', 'currentUid'];
      }

      function turnKeys() {
        return ['deck', 'hand', 'locked', 'drawsUsed'];
      }

      // Turno vazio (antes da 1ª tirada e depois de marcar).
      function emptyTurn() {
        return { 'deck': [], 'hand': [], 'locked': [false, false, false, false, false], 'drawsUsed': 0 };
      }

      // ======================================================= auxiliares

      // Usuário logado (Google ou convidado/anônimo).
      function signedIn() {
        return request.auth != null;
      }

      // Apelido: texto de 1 a 16 caracteres.
      function validName(name) {
        return name is string && name.size() >= 1 && name.size() <= 16;
      }

      // Código: exatamente 6 caracteres, sem os ambíguos 0/O e 1/I/L.
      function validCode() {
        return code.matches('^[2-9A-HJKMNP-Z]{6}$');
      }

      // Validade da sala (TTL): agora + 24 h, aceitando de 12 h a 36 h por causa
      // do relógio do aparelho, que pode estar um pouco errado.
      function expireAtOk(n) {
        return n.expireAt is timestamp &&
          n.expireAt > request.time + duration.value(12, 'h') &&
          n.expireAt < request.time + duration.value(36, 'h');
      }

      // Sala ainda válida (salas antigas sem expireAt: updatedAt + 24 h).
      function notExpired(s) {
        return request.time < s.get('expireAt', s.updatedAt + duration.value(24, 'h'));
      }

      // O outro membro da sala (para quem é membro).
      function opponentOf(s) {
        return s.hostUid == request.auth.uid ? s.guestUid : s.hostUid;
      }

      // 5 cartas de 1 a 6.
      function handOk(hand) {
        return hand is list && hand.size() == 5 && hand.hasOnly([1, 2, 3, 4, 5, 6]);
      }

      // 5 cadeados (booleanos).
      function locksOk(locked) {
        return locked is list && locked.size() == 5 && locked.hasOnly([true, false]);
      }

      // ==================================================== partida nova

      // Placar de uma partida nova: exatamente as categorias do modo, todas vazias.
      function freshScores(scores, cats) {
        return scores.keys().hasOnly(cats) && scores.keys().hasAll(cats) && scores.values().hasOnly([null]);
      }

      // Jogador no `game`: { id, name } com o mesmo apelido gravado na sala.
      function gamePlayerOk(s, p) {
        return p.keys().hasOnly(['id', 'name']) && p.id in [s.hostUid, s.guestUid] &&
          p.name == s.players[p.id].name;
      }

      // Partida nova (começar ou revanche), conferida contra a sala ANTES (s):
      // só os campos do core (+ currentUid), modo da sala, tiradas e categorias
      // do modo, baralho de 6 cópias por valor, os dois membros como jogadores,
      // vez do primeiro, rodada 0, turno vazio e todas as categorias vazias.
      // `mode` = { draws, cats }: ao começar, vem da tabela modes(); na
      // revanche, do game anterior (que já foi conferido contra a tabela ao
      // começar e cujos campos fixos nunca mudam) — montar a tabela inteira
      // custa ~100 expressões.
      function newGameOk(s, g, mode) {
        let host = s.hostUid;
        let guest = s.guestUid;
        return g.keys().hasOnly(gameKeys()) && g.keys().hasAll(gameKeys()) &&
          g.modeId == s.mode &&
          g.maxDraws == mode.draws &&
          g.categories == mode.cats &&
          g.deckCopiesPerValue == 6 &&
          g.players is list && g.players.size() == 2 &&
          gamePlayerOk(s, g.players[0]) && gamePlayerOk(s, g.players[1]) &&
          g.players[0].id != g.players[1].id &&
          g.currentPlayerIndex == 0 &&
          g.currentUid == g.players[0].id &&
          g.round == 0 &&
          g.status == 'playing' &&
          g.turn == emptyTurn() &&
          g.lastScored == null &&
          g.scores.keys().hasOnly([host, guest]) && g.scores.keys().hasAll([host, guest]) &&
          freshScores(g.scores[host], mode.cats) &&
          freshScores(g.scores[guest], mode.cats);
      }

      // ================================================ jogadas da partida
      // s = game gravado, n = game novo. O game gravado já é válido (foi
      // conferido quando gravado), então basta conferir o que muda.

      // Qual jogada é: pelo drawsUsed novo. 0 → marcação (o turno volta a
      // vazio); igual ao anterior → cadeado; senão → tirada.
      function validMove(s, n) {
        return s.status == 'playing' &&
          (n.turn.drawsUsed == 0
            ? scoreMove(s, n)
            : (n.turn.drawsUsed == s.turn.drawsUsed ? lockMove(s, n) : drawMove(s, n)));
      }

      // CADEADO: no game só o turno muda, e no turno só os cadeados
      // (mão, baralho e tiradas iguais). drawsUsed ≥ 1 vem do despacho.
      function lockMove(s, n) {
        return n.diff(s).affectedKeys().hasOnly(['turn']) &&
          n.turn.diff(s.turn).affectedKeys().hasOnly(['locked']) &&
          locksOk(n.turn.locked);
      }

      // TIRADA: no game só o turno muda; drawsUsed sobe exatamente 1, sem
      // passar do limite do modo; 5 cartas de 1 a 6.
      function drawMove(s, n) {
        let t = n.turn;
        return n.diff(s).affectedKeys().hasOnly(['turn']) &&
          t.diff(s.turn).affectedKeys().hasOnly(turnKeys()) &&
          t.drawsUsed == s.turn.drawsUsed + 1 &&
          t.drawsUsed <= s.maxDraws &&
          handOk(t.hand) &&
          t.deck is list && t.deck.hasOnly([1, 2, 3, 4, 5, 6]) &&
          (s.turn.drawsUsed == 0 ? firstDraw(s, t) : redraw(s.turn, t));
      }

      // 1ª tirada: nada trancado, baralho com 36 − 5 = 31.
      function firstDraw(s, t) {
        return t.locked == [false, false, false, false, false] &&
          t.deck.size() == s.deckCopiesPerValue * 6 - 5;
      }

      // Demais tiradas: cadeados iguais, cartas trancadas iguais, pelo menos
      // uma carta trocada e o baralho encolhe exatamente o número de trocadas.
      function redraw(st, t) {
        let l = st.locked;
        let replaced = (l[0] ? 0 : 1) + (l[1] ? 0 : 1) + (l[2] ? 0 : 1) + (l[3] ? 0 : 1) + (l[4] ? 0 : 1);
        return t.locked == l &&
          replaced >= 1 &&
          (!l[0] || t.hand[0] == st.hand[0]) &&
          (!l[1] || t.hand[1] == st.hand[1]) &&
          (!l[2] || t.hand[2] == st.hand[2]) &&
          (!l[3] || t.hand[3] == st.hand[3]) &&
          (!l[4] || t.hand[4] == st.hand[4]) &&
          t.deck.size() == st.deck.size() - replaced;
      }

      // MARCAÇÃO: precisa ter tirado; preenche UMA categoria VAZIA do jogador
      // da vez, com valor inteiro dentro da faixa da categoria (igual a
      // lastScored.points); o placar do outro, as categorias já marcadas e os
      // campos fixos (modo, jogadores…) não mudam; o turno volta a vazio; a vez
      // passa ao outro — ou, se todo mundo preencheu tudo, a partida termina e
      // a vez fica onde estava.
      function scoreMove(s, n) {
        let player = s.currentUid;
        let other = s.players[1 - s.currentPlayerIndex].id;
        let last = n.lastScored;
        let cat = last.categoryId;
        let range = catRange()[cat];
        return s.turn.drawsUsed >= 1 &&
          n.diff(s).affectedKeys().hasOnly(['scores', 'turn', 'currentPlayerIndex', 'round', 'status',
            'lastScored', 'currentUid']) &&
          n.turn == emptyTurn() &&
          last.keys().hasOnly(['playerId', 'categoryId', 'points']) &&
          last.playerId == player &&
          cat in s.categories &&
          last.points is int && last.points >= range[0] && last.points <= range[1] &&
          s.scores[player][cat] == null &&
          n.scores.diff(s.scores).affectedKeys().hasOnly([player]) &&
          n.scores[player].diff(s.scores[player]).affectedKeys().hasOnly([cat]) &&
          n.scores[player][cat] == last.points &&
          n.currentUid == n.players[n.currentPlayerIndex].id &&
          turnPassed(s, n, !(null in n.scores[player].values()) && !(null in n.scores[other].values()));
      }

      function turnPassed(s, n, allFilled) {
        return allFilled
          ? (n.status == 'finished' && n.currentPlayerIndex == s.currentPlayerIndex && n.round == s.round)
          : (n.status == 'playing' && n.currentPlayerIndex == 1 - s.currentPlayerIndex &&
             n.round == (n.currentPlayerIndex == 0 ? s.round + 1 : s.round));
      }

      // ===================================== conferências de toda gravação
      // s = sala antes, n = sala depois, ch = campos de 1º nível alterados.

      // hostUid, guestUid, players (apelidos), mode, timerEnabled e createdAt
      // nunca mudam depois de criados. (O guestUid é preenchido uma única vez,
      // quando o amigo entra — isso é tratado em joining(), separado.)
      function fixedFieldsKept(ch) {
        return !ch.hasAny(['hostUid', 'guestUid', 'players', 'mode', 'timerEnabled', 'createdAt']);
      }

      // Presença (lastSeen): cada jogador só altera a PRÓPRIA chave, e sempre
      // com o horário do servidor (serverTimestamp), para ninguém falsificar.
      function presenceOk(s, n, ch) {
        return !ch.hasAny(['presence']) || (
          n.presence.diff(s.presence).affectedKeys().hasOnly([request.auth.uid]) &&
          n.presence[request.auth.uid] == request.time
        );
      }

      // Voto de revanche: cada jogador só altera o PRÓPRIO voto, e o voto vale
      // para a partida atual (rematch[uid] == match).
      function rematchOk(s, n, ch) {
        return !ch.hasAny(['rematch']) || (
          n.rematch.diff(s.rematch).affectedKeys().hasOnly([request.auth.uid]) &&
          n.rematch[request.auth.uid] == s.match
        );
      }

      // updatedAt só pode receber o horário do servidor; expireAt, se mudar,
      // tem que ser "agora + 24 h".
      function timesOk(n, ch) {
        return (!ch.hasAny(['updatedAt']) || n.updatedAt == request.time) &&
          (!ch.hasAny(['expireAt']) || expireAtOk(n));
      }

      // ================================================== ações permitidas

      // Gravação de quem já é membro: as conferências gerais e UMA ação.
      // Toda gravação que muda o jogo sobe o rev em EXATAMENTE 1 (duas
      // gravações baseadas no mesmo estado não passam as duas) — e só elas
      // mexem no rev. Sem rev: sinal de vida, voto de revanche ou abandono.
      function memberUpdate(s, n, ch) {
        return fixedFieldsKept(ch) && presenceOk(s, n, ch) && rematchOk(s, n, ch) && timesOk(n, ch) &&
          (ch.hasAny(['rev'])
            ? (n.rev is int && n.rev == s.rev + 1 && gameWrite(s, n, ch))
            : (ch.hasOnly(['presence']) || votingRematch(s, ch) || forfeiting(s, n, ch)));
      }

      // Gravações que mudam o jogo, pelo status da sala antes.
      function gameWrite(s, n, ch) {
        return s.status == 'waiting'
          ? starting(s, n, ch)
          : (s.status == 'playing' ? playingMove(s, n, ch) : restarting(s, n, ch));
      }

      // ENTRAR: quem não é membro preenche guestUid com o próprio uid, só se a
      // vaga estava vazia, a sala está em espera e não expirou. Junto, só pode
      // gravar o próprio apelido, a própria presença e renovar o expireAt.
      function joining(s, n, ch) {
        let me = request.auth.uid;
        return s.status == 'waiting' &&
          s.guestUid == null &&
          notExpired(s) &&
          ch.hasOnly(['guestUid', 'players', 'presence', 'updatedAt', 'expireAt']) &&
          n.guestUid == me &&
          n.players.diff(s.players).affectedKeys().hasOnly([me]) &&
          n.players[me].keys().hasOnly(['name']) &&
          validName(n.players[me].name) &&
          n.presence.diff(s.presence).affectedKeys().hasOnly([me]) &&
          n.presence[me] == request.time &&
          n.updatedAt == request.time &&
          timesOk(n, ch);
      }

      // COMEÇAR: só o anfitrião, com a sala em espera e o convidado presente.
      // A sala passa a 'playing', partida nº 1, com um jogo novo válido.
      function starting(s, n, ch) {
        return s.hostUid == request.auth.uid &&
          s.guestUid != null &&
          ch.hasOnly(['status', 'game', 'rev', 'match', 'presence', 'updatedAt', 'expireAt']) &&
          n.status == 'playing' &&
          n.match == 1 &&
          expireAtOk(n) &&
          newGameOk(s, n.game, modes()[s.mode]);
      }

      // JOGADA: só quem é o currentUid ATUAL (antes da gravação) altera o game,
      // com expireAt renovado e uma jogada válida (cadeado, tirada ou
      // marcação). A sala só vira 'finished' junto com o fim do próprio game.
      function playingMove(s, n, ch) {
        return s.game.currentUid == request.auth.uid &&
          ch.hasOnly(['game', 'rev', 'status', 'presence', 'updatedAt', 'expireAt']) &&
          expireAtOk(n) &&
          n.status == n.game.status &&
          validMove(s.game, n.game);
      }

      // REVANCHE: com a partida terminada, quem vota por último recomeça — desde
      // que o OUTRO já tenha votado nesta partida. Partida nº + 1, jogo novo
      // válido, e o abandono anterior (se houve) é apagado.
      function restarting(s, n, ch) {
        return s.status == 'finished' &&
          ch.hasOnly(['status', 'game', 'rev', 'match', 'rematch', 'forfeitUid', 'presence', 'updatedAt', 'expireAt']) &&
          n.status == 'playing' &&
          n.match == s.match + 1 &&
          expireAtOk(n) &&
          n.rematch[request.auth.uid] == s.match &&
          n.rematch.get(opponentOf(s), -1) == s.match &&
          n.forfeitUid == null &&
          s.game.modeId == s.mode &&
          newGameOk(s, n.game, { 'draws': s.game.maxDraws, 'cats': s.game.categories });
      }

      // PEDIR REVANCHE: com a partida terminada, o membro grava só o próprio
      // voto (conferido em rematchOk).
      function votingRematch(s, ch) {
        return s.status == 'finished' && ch.hasOnly(['rematch', 'presence', 'updatedAt']);
      }

      // ABANDONO: durante a partida, um membro encerra se o OUTRO está sem sinal
      // de vida há mais de 2 minutos (conferido com o relógio do servidor). O
      // game não muda; forfeitUid aponta quem abandonou.
      function forfeiting(s, n, ch) {
        let other = opponentOf(s);
        return s.status == 'playing' &&
          ch.hasOnly(['status', 'forfeitUid', 'presence', 'updatedAt']) &&
          n.status == 'finished' &&
          n.forfeitUid == other &&
          request.time > s.presence.get(other, s.updatedAt) + duration.value(2, 'm');
      }

      // ============================================================= regras

      // LER uma sala (get): precisa estar logado e ser membro — ou a sala estar
      // em espera, para quem tem o código conseguir entrar. Ler um código que
      // não existe (resource == null) é permitido: é assim que a tela diz "sala
      // não existe" e que a criação confere se o código está livre.
      allow get: if signedIn() && (
        resource == null ||
        resource.data.hostUid == request.auth.uid ||
        resource.data.guestUid == request.auth.uid ||
        resource.data.status == 'waiting'
      );

      // LISTAR a coleção: ninguém (não dá para descobrir códigos de outras salas).
      allow list: if false;

      // CRIAR: logado, código válido no id, eu sou o anfitrião, apelido de 1 a 16,
      // modo existente, vaga do convidado vazia, sala em espera, sem jogo,
      // contadores zerados, horários do servidor, expireAt = agora + 24 h e
      // exatamente os campos esperados.
      allow create: if signedIn() && validCode() && newRoomOk(request.resource.data, request.auth.uid);

      function newRoomOk(n, me) {
        return n.keys().hasOnly(roomKeys()) &&
          n.keys().hasAll(roomKeys()) &&
          n.hostUid == me &&
          n.guestUid == null &&
          n.players.keys().hasOnly([me]) &&
          n.players[me].keys().hasOnly(['name']) &&
          validName(n.players[me].name) &&
          n.mode in modes() &&
          n.timerEnabled is bool &&
          n.status == 'waiting' &&
          n.game == null &&
          n.rev == 0 &&
          n.match == 0 &&
          n.createdAt == request.time &&
          n.updatedAt == request.time &&
          expireAtOk(n) &&
          n.presence.keys().hasOnly([me]) &&
          n.presence[me] == request.time &&
          n.rematch.size() == 0 &&
          n.forfeitUid == null;
      }

      // ATUALIZAR: sem campos extras; quem é membro faz uma das ações acima
      // (memberUpdate), quem não é só pode entrar (joining).
      allow update: if signedIn() &&
        request.resource.data.keys().hasOnly(roomKeys()) &&
        roomUpdate(resource.data, request.resource.data, request.resource.data.diff(resource.data).affectedKeys());

      function roomUpdate(s, n, ch) {
        return (s.hostUid == request.auth.uid || s.guestUid == request.auth.uid)
          ? memberUpdate(s, n, ch)
          : joining(s, n, ch);
      }

      // APAGAR pelo cliente: nunca. Salas vencidas (expireAt no passado) são
      // ignoradas pelo jogo e apagadas pela política de TTL do Firestore, se
      // estiver ativada (precisa do plano Blaze).
      allow delete: if false;
    }
  }
}
